generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id               Int      @id @default(1)
  age              Int
  weightKg         Float
  heightCm         Int
  sex              Sex
  // Composition corporelle : mesure actuelle (renseignée à la main ou reprise de
  // la dernière pesée importée) et objectif visé.
  //
  // Il n'y a volontairement PAS de poids cible : l'objectif est exprimé en % de
  // masse grasse, et le poids correspondant s'en déduit (voir lib/body.ts).
  bodyFatPct       Float?
  targetBodyFatPct Float?
  updatedAt        DateTime @updatedAt
}

model Food {
  fdcId       Int         @id
  name        String
  nameFr      String?
  dataType    String
  nutrients   Json
  cachedAt    DateTime    @default(now())
  mealEntries MealEntry[]
}

model CustomFood {
  id          Int         @id @default(autoincrement())
  name        String
  nutrients   Json
  createdAt   DateTime    @default(now())
  mealEntries MealEntry[]
}

model MealEntry {
  id           Int         @id @default(autoincrement())
  day          DayOfWeek
  meal         MealType
  grams        Float
  foodId       Int?
  customFoodId Int?
  food         Food?       @relation(fields: [foodId], references: [fdcId])
  customFood   CustomFood? @relation(fields: [customFoodId], references: [id])

  @@unique([day, meal, foodId])
  @@unique([day, meal, customFoodId])
}

model IgnoredFood {
  fdcId     Int      @id
  name      String
  ignoredAt DateTime @default(now())
}

model Translation {
  source    String   @id
  target    String
  createdAt DateTime @default(now())
}

/// Une pesée sur balance connectée (import FeelFit ou saisie manuelle).
/// Tous les champs hors date/poids sont optionnels : selon la balance et la
/// version de l'export, certaines colonnes sont absentes.
model BodyMeasurement {
  id             Int      @id @default(autoincrement())
  measuredAt     DateTime @unique
  weightKg       Float
  bmi            Float?
  bodyFatPct     Float?
  musclePct      Float?
  muscleMassKg   Float?
  waterPct       Float?
  proteinPct     Float?
  boneMassKg     Float?
  visceralFat    Float?
  bmrKcal        Float?
  subcutaneousFatPct Float?
  skeletalMusclePct  Float?
  metabolicAge   Float?
  source         String   @default("feelfit")
  createdAt      DateTime @default(now())

  @@index([measuredAt])
}

model Backup {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  trigger   String   @default("manual") // "cron" | "manual"
  data      Json
}

enum Sex {
  MALE
  FEMALE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  SNACK
  DINNER
}
